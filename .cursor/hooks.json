{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd before-submit-prompt",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd after-agent-response"
      }
    ],
    "afterAgentThought": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd after-agent-thought"
      }
    ],
    "postToolUse": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd post-tool-use"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd post-tool-use-failure"
      }
    ],
    "subagentStart": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd subagent-start"
      }
    ],
    "subagentStop": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd subagent-stop"
      }
    ],
    "stop": [
      {
        "command": "/usr/local/lib/langsmith-tracing/binary/langsmith-tracing.cmd stop"
      }
    ]
  }
}
